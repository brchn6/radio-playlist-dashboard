# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# All Supabase values come from your project:
#   Dashboard -> Project Settings -> API Keys / Database

# e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# The SECRET key (`sb_secret_...`; on older projects, the `service_role` JWT).
#
# It bypasses Row Level Security — that is exactly why the collector can write
# and the public cannot. Treat it like a password:
#   - it belongs ONLY in this .env, on the collector machine
#   - it must NEVER appear in docs/, in the frontend, or in a commit
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# The Postgres password used by scripts/supabase_db.py to connect directly to
# the DB (the collector's whole write path goes through psycopg2).
#
# Where to find it: Supabase Dashboard -> Project Settings -> Database ->
# "Connection string" (URI) — the password is the part after
# `postgresql://postgres.` in the URI. If you never set one, it was generated
# at project creation; reset it with the "Reset database password" button
# right there and copy the new value.
#
# Also required: deploy/install.sh refuses to install without it.
SUPABASE_DB_PASSWORD=your_postgres_password_here

# Optional. Derived from SUPABASE_URL automatically if unset
# (https://abc.supabase.co -> db.abc.supabase.co); set it only if your
# project's Postgres host differs from the default.
# SUPABASE_DB_HOST=db.abcdefghijklm.supabase.co

# Optional. The publishable/anon key is NOT needed by this project: the dashboard
# reads a public Storage bucket, so the page embeds no key at all.
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional. Only needed for the Spotify "add to playlist" service
# (scripts/spotify_api.py / scripts/spotify_add_to_playlist.py). manage.sh
# skips starting that service when these are absent.
# Get them from https://developer.spotify.com/dashboard (your app's client id
# and secret).
# SPOTIFY_CLIENT_ID=your_spotify_client_id
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# GIT_TOKEN is gone. The collector no longer pushes to git — that was the
# ~720-commits/day pattern that risked a ToS strike. GitHub Pages now only
# serves the static frontend, deployed by Actions on real code commits.
